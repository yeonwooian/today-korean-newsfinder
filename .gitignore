# 가상환경 (용량이 크고 윈도우 전용 파일이므로 절대 업로드 금지)
.venv/
env/
venv/
ENV/

# 파이썬 바이트코드 및 캐시
__pycache__/
*.py[cod]
*$py.class
*.log

# 스트림릿 로컬 시크릿 파일 (실제 키가 담긴 파일은 깃허브 업로드 제외)
.streamlit/secrets.toml

# 환경변수 파일
.env

# 이전 생성 결과물 폴더 내 임시 파일들
output/*
!output/.gitkeep

# 임시 스크랩 및 압축 파일
*.zip
scraped_article.txt
scratch/

# OS 시스템 파일
.DS_Store
Thumbs.db
